# RPC Sepolia. Optionnel : par defaut, hardhat.config.ts utilise un RPC public
# (https://ethereum-sepolia-rpc.publicnode.com). Renseigne ta propre cle
# Alchemy/Infura ici pour plus de fiabilite.
SEPOLIA_RPC_URL=

# Cle privee du compte qui deploie et administre la suite T-REX de test sur
# Sepolia. Jamais commitee (voir .gitignore). Format : 0x suivi de 64 hex.
DEPLOYER_PRIVATE_KEY=

# Optionnel : pour verifier les contrats sur Etherscan apres deploiement.
ETHERSCAN_API_KEY=
